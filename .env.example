# Copy this file to .env.local and fill in the values (never commit .env.local).
# Find them in Supabase: Project Settings > API Keys (and Data API for the URL),
# or run `npx vercel env pull .env.local` once the Vercel CLI is linked.

# Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Either name works: newer projects call this the "publishable" key, older ones the "anon" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security; never prefix with NEXT_PUBLIC_
# and never import it into browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Signs the QR check-in demo codes. Any long random string, e.g. the
# output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_DEMO_SECRET=
